<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Gera o XML dos comentários /// para aparecerem no Swagger -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AprenderMais.Dominio\AprenderMais.Dominio.csproj" />
    <ProjectReference Include="..\AprenderMais.Aplicacao\AprenderMais.Aplicacao.csproj" />
    <ProjectReference Include="..\AprenderMais.Infraestrutura\AprenderMais.Infraestrutura.csproj" />
  </ItemGroup>

</Project>
